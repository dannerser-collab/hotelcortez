PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=hotel_cortez

# Hora local del hotel (Node y MySQL usan la misma)
APP_TZ=America/La_Paz
DB_TZ_OFFSET=-04:00

# Duración de la sesión en horas
SESION_HORAS=12

# Orígenes permitidos (solo si el frontend se sirve desde otro dominio). Vacío = mismo origen.
CORS_ORIGIN=

# Carpeta de fotos (relativa a backend/)
UPLOADS_DIR=uploads

# Notificaciones push (opcional). Genera claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mantenimiento@hotelcortez.local

# Ruta de mysqldump para "npm run respaldo" (Windows)
MYSQLDUMP=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
